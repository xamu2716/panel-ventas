NEXT_PUBLIC_SUPABASE_URL=
# Usa la clave "anon" clásica (JWT), no la "publishable" nueva: las políticas RLS
# de este proyecto están escritas "to anon" y la publishable key no calza con ese rol.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Keep-alive cron (solo servidor, sin NEXT_PUBLIC_): ver app/api/cron/keep-alive
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
